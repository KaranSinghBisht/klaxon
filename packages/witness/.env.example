# @klaxon/witness — every value is read from the environment and validated at boot; absence throws.
# Copy to .env for local runs. On Fly the four secrets below go in `fly secrets set`, the rest in
# fly.toml's [env] block.

# --- process ---
KLAXON_DB_PATH=./klaxon.db
KLAXON_HOST=0.0.0.0
PORT=8080
KLAXON_PUBLIC_URL=https://klaxon-witness.fly.dev
KLAXON_LOG_LEVEL=info

# --- SECRET. 32 bytes, hex or base64. Back this up ON PAPER before the first `klaxon add`: it is
# --- the key `klaxon emergency` needs, and losing it makes every protected secret undecryptable.
WITNESS_MASTER=

# --- Hedera. HEDERA_OPERATOR_KEY is a SECRET; it both pays for HCS submits and receives payments.
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.0000000
HEDERA_OPERATOR_KEY=
HEDERA_KEY_TYPE=ecdsa
# Defaults to HEDERA_OPERATOR_ID; set only when the payee and the HCS operator differ.
KLAXON_WITNESS_ACCOUNT=
MIRROR_NODE=https://testnet.mirrornode.hedera.com

# --- x402 / Blocky402 ---
X402_FACILITATOR=https://api.testnet.blocky402.com
X402_NETWORK=hedera:testnet
X402_ASSET=0.0.0
X402_PRICE_TINYBAR=100000
X402_MAX_TIMEOUT_S=120

# --- Sepolia KlaxonRegistry ---
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
KLAXON_REGISTRY=0x0000000000000000000000000000000000000000
KLAXON_REGISTRY_DEPLOY_BLOCK=0
CONFIRMATIONS=3
KLAXON_REGISTRY_POLL_MS=15000

# --- policy and workflow source. `raw` needs no token (D7); `api` is for private repositories.
KLAXON_SOURCE=raw
GITHUB_TOKEN=

# --- GitHub OIDC ---
KLAXON_OIDC_ISSUER=https://token.actions.githubusercontent.com
KLAXON_OIDC_JWKS_URL=https://token.actions.githubusercontent.com/.well-known/jwks

# --- alarm. The topic name IS the password: use `klaxon-<32 hex>`, never a guessable name.
NTFY_BASE=https://ntfy.sh
NTFY_DEFAULT_TOPIC=

# --- policy knobs ---
KLAXON_PAYMENT_MAX_AGE_S=600
KLAXON_CLOCK_TOLERANCE_S=60
KLAXON_REVOKE_ON_BUDGET=false
KLAXON_MAX_RELEASES_DEFAULT=50

# --- background jobs ---
KLAXON_OUTBOX_POLL_MS=5000
KLAXON_JWKS_SNAPSHOT_MS=86400000
