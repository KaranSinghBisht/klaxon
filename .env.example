# Copy to .env. Every name here is the name the code actually reads — the witness's are validated
# by `packages/witness/src/env.ts` and throw at boot if wrong.

# ---- laptop (operator) ----
WALLET_PASS=                # the `ring init` password; unwraps the keychain entry for `klaxon export-member`
WALLET_CLI_BIN=             # optional: path to the wallet-cli binary (default: `wallet-cli` on PATH)
WITNESS_MASTER=             # 32 bytes hex — the ONLY witness state that matters; back it up on paper
HEDERA_OPERATOR_ID=         # laptop Hedera account: topic creation, and the HCS submit key's second member
HEDERA_OPERATOR_KEY=        # 0x-prefixed ECDSA private key
KLAXON_PAY_ACCOUNT=         # 0.0.xxxxxxx — the account `klaxon emergency` pays the commitment from
KLAXON_PAY_KEY=             # its private key; `emergency` refuses to run unpaid without --no-pay

# ---- contracts (Foundry) ----
DEPLOY_KEY=                 # throwaway Sepolia/Base deployer EOA — never the Ledger. `script/Deploy.s.sol`
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
ETHERSCAN_API_KEY=          # Etherscan V2, one key for both chains (foundry.toml [etherscan])

# ---- demo only (script/DeployTreasury.s.sol) ----
DEPLOYER_PRIVATE_KEY=       # the secret KLAXON protects in the demo; deploys demo/treasury
TREASURY_FUND_WEI=0         # optional: wei to send the Treasury on deploy

# ---- witness ----
# The full list with defaults is `packages/witness/.env.example`. Five have no default and throw
# at boot if absent: KLAXON_PUBLIC_URL, WITNESS_MASTER, HEDERA_OPERATOR_ID, HEDERA_OPERATOR_KEY,
# KLAXON_REGISTRY. On Fly, only the secrets go in `fly secrets set`; the rest in fly.toml [env].
# KLAXON_PUBLIC_URL=https://klaxon-witness.fly.dev   # required — the manifest's release_endpoint
# WITNESS_MASTER=<64 hex>                            # secret
# HEDERA_OPERATOR_ID=0.0.xxxxxxx                     # witness account: HCS submit + x402 payee
# HEDERA_OPERATOR_KEY=<key>                          # secret
# KLAXON_REGISTRY=0x…                                # KlaxonRegistry on Sepolia
# NTFY_DEFAULT_TOPIC=klaxon-<32 hex>                 # the topic name IS the password
# X402_FACILITATOR=https://api.testnet.blocky402.com
# MIRROR_NODE=https://testnet.mirrornode.hedera.com
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ---- GitHub (per protected repo) ----
# secrets.KLAXON_MEMBER      one base64 line from `klaxon export-member`
# secrets.KLAXON_PAY_KEY     0x-prefixed ECDSA key of a dedicated Hedera account holding ~5 ℏ
# vars.KLAXON_PAY_ACCOUNT    0.0.xxxxxxx — a public account id, so a variable and not a secret
