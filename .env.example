# ---- laptop (operator) ----
DEPLOY_KEY=                 # throwaway Sepolia/Base deployer EOA — never the Ledger
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
ETHERSCAN_API_KEY=          # Etherscan V2, one key for all chains
WALLET_PASS=                # the ring init password; used ONLY by `klaxon export-member` on the laptop
HEDERA_OPERATOR_ID=         # laptop Hedera account (topic creation, emergency payments)
HEDERA_OPERATOR_KEY=        # 0x-prefixed ECDSA private key
WITNESS_MASTER=             # 32 bytes hex — the ONLY witness state that matters; back it up on paper

# ---- witness (Fly secrets) ----
# HEDERA_OPERATOR_ID / HEDERA_OPERATOR_KEY  (witness account: HCS submit + x402 payee)
# WITNESS_MASTER
# NTFY_TOPIC=klaxon-<32 hex>
# KLAXON_REGISTRY_ADDRESS=0x…
# X402_FACILITATOR_URL=https://api.testnet.blocky402.com
# MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
# SEPOLIA_RPC_URL

# ---- GitHub (per protected repo) ----
# secrets.KLAXON_MEMBER      one base64 line from `klaxon export-member`
# secrets.KLAXON_PAY_KEY     0x-prefixed ECDSA key of a dedicated Hedera account holding ~5 ℏ
# vars.KLAXON_PAY_ACCOUNT    0.0.xxxxxxx
