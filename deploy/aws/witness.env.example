# Copy to witness.env on the box and fill the four secrets. Everything else is the Sepolia
# deployment (Sept 10) and the testnet endpoints.
PORT=8080
KLAXON_DB_PATH=/data/klaxon.db
KLAXON_HOST=0.0.0.0
KLAXON_LOG_LEVEL=info

# Set to https://<your-elastic-ip-with-dashes>.sslip.io (same host as SITE_ADDRESS).
KLAXON_PUBLIC_URL=https://REPLACE-WITH-EIP.sslip.io

HEDERA_NETWORK=testnet
X402_FACILITATOR=https://api.testnet.blocky402.com
X402_NETWORK=hedera:testnet
X402_ASSET=0.0.0
X402_PRICE_TINYBAR=100000
MIRROR_NODE=https://testnet.mirrornode.hedera.com

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
KLAXON_REGISTRY=0xd93f10104d4069B26c8ee883c3eAb3AAaaD56885
KLAXON_REGISTRY_DEPLOY_BLOCK=11674139
CONFIRMATIONS=3
KLAXON_SOURCE=raw
NTFY_BASE=https://ntfy.sh

# --- secrets: fill these in, never commit witness.env ---
WITNESS_MASTER=
HEDERA_OPERATOR_ID=0.0.10455530
HEDERA_OPERATOR_KEY=
NTFY_DEFAULT_TOPIC=
